{
  "manifest_version": 3,
  "name": "Cute Job Platform — Resume Generator",
  "version": "1.4.0",
  "description": "Select a job description on any page, right-click, and generate a tailored resume PDF from the Cute Job Platform.",
  "permissions": ["contextMenus", "storage", "downloads", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resume Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
