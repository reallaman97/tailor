# Postgres connection string (Neon pooled connection string in prod/dev).
# `uselibpqcompat=true` silences the pg driver's v9 sslmode deprecation warning
# while keeping sslmode=require's current behavior.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&uselibpqcompat=true"

# App-wide master key that wraps each user's per-user data encryption key
# (envelope encryption for Profile/Resume sensitive fields).
# Generate with: openssl rand -base64 32
# NEVER commit the real value or reuse it across environments.
MASTER_KEY=""

# Auth.js session/CSRF signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Resend (transactional email for password reset). Free tier: resend.com
RESEND_API_KEY=""
# Sandbox sender only deliverable to your own Resend account email until you
# verify a domain — swap before onboarding real users.
EMAIL_FROM="onboarding@resend.dev"

# Base URL used to build links in emails (e.g. password reset).
APP_URL="http://localhost:3000"

# OpenAI (resume import parsing, and later the tailoring pipeline).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# DeepSeek (resume generation). Role classification, job-posting extraction and
# Application Checks still use OpenAI above. Key from platform.deepseek.com.
DEEPSEEK_API_KEY=""

# The secret resume-generation prompt, base64-encoded UTF-8. It is never stored
# in the DB or shown in the web portal. Encode the prompt file with:
#   node -e "process.stdout.write(Buffer.from(require('fs').readFileSync('prompt.md','utf8')).toString('base64'))"
# Service Admin → Tailoring shows its SHA-256 so you can verify what's deployed.
RESUME_PROMPT_B64=""

# Auto-setup (npm run setup / vercel-build): if both are set, a SUPERADMIN
# account is created (or ensured) on setup. Leave blank to skip. An existing
# account keeps its password — only role/approval are ensured.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_USERNAME=""

# --- Google Calendar sync (Interview Management) ---
# OAuth client from Google Cloud → APIs & Services → Credentials (Web app).
# Enable the "Google Calendar API". Keep the OAuth app "Internal" (Workspace) or
# in "Testing" mode so the calendar.readonly restricted scope needs NO Google
# verification. Add this authorized redirect URI to the client:
#   <your-app-origin>/api/calendar/google/callback
# Leave blank to hide/disable calendar sync (the app degrades gracefully).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: pin the callback URL if the request origin isn't your public origin
# (e.g. behind a proxy). Otherwise it's derived from the request origin.
GOOGLE_REDIRECT_URI=""

# Protects the scheduled calendar-sync cron (/api/cron/calendar-sync). Vercel
# sends this automatically as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
