# Postgres connection string (Neon pooled connection string in prod/dev).
# `uselibpqcompat=true` silences the pg driver's v9 sslmode deprecation warning
# while keeping sslmode=require's current behavior.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&uselibpqcompat=true"

# App-wide master key that wraps each user's per-user data encryption key
# (envelope encryption for Profile/Resume sensitive fields).
# Generate with: openssl rand -base64 32
# NEVER commit the real value or reuse it across environments.
MASTER_KEY=""

# Auth.js session/CSRF signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Resend (transactional email for password reset). Free tier: resend.com
RESEND_API_KEY=""
# Sandbox sender only deliverable to your own Resend account email until you
# verify a domain — swap before onboarding real users.
EMAIL_FROM="onboarding@resend.dev"

# Base URL used to build links in emails (e.g. password reset).
APP_URL="http://localhost:3000"

# OpenAI (resume import parsing, and later the tailoring pipeline).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
