// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth ──────────────────────────────────────────────

enum UserRole {
  SUPERADMIN
  BIDDER
  CALLER
  // Interview Management operator: full CRUD on interviews, assigns callers,
  // and configures interview settings. Distinct from BIDDER (Resume Platform).
  MANAGER
  // Platform owner ("Service Real Admin") — controls Teams and can act inside
  // any team. Belongs to no single team. (Phase 2 migrates today's SUPERADMIN
  // accounts to this.) Appended at the end to keep the enum change additive.
  SERVICE_ADMIN
  // Per-team admin — today's SUPERADMIN powers, scoped to one team; used as the
  // role on TeamMembership. (Phase 2 wires auth to team-scoped roles.)
  TEAM_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique // login credential — separate from Profile.contactEmail
  // Human-facing handle chosen at signup. Login still uses email; this is how a
  // user is identified in the admin tools, tracker, and dashboard.
  username      String    @unique
  passwordHash  String
  emailVerified DateTime?
  role          UserRole  @default(BIDDER)
  // New sign-ups start unapproved and cannot log in until a superadmin
  // flips this — see AccountPendingApprovalError in src/auth.ts.
  approved      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Envelope encryption: this per-user DEK is itself encrypted with the
  // app-wide master key (env var). Used only for Resume.tailoredContentEnc —
  // deliberately independent of whichever Profile (if any) is assigned to
  // this account, so reassigning a profile never breaks past tailored resumes.
  encryptedDek String

  // Many-to-one: many user accounts may be assigned the same pool profile.
  // Deleting a profile unassigns every account pointing to it rather than
  // failing or cascading.
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  resumes        Resume[]
  passwordResets PasswordResetToken[]
  usageEvents    UsageEvent[]

  // Interview Management: interviews this user created (as a Manager/Super Admin)
  // vs. interviews assigned to them (as a Caller) — two distinct relations, so
  // they need explicit @relation names to disambiguate.
  createdInterviews  Interview[]              @relation("InterviewCreatedBy")
  assignedInterviews Interview[]              @relation("InterviewCaller")
  interviewComments  InterviewComment[]
  interviewFiles     InterviewReferenceFile[]
  // Recurring weekly availability a Caller submits; managers view it in aggregate.
  availability       CallerAvailability[]
  // Connected external calendar (Google/Outlook) whose events overlay the
  // interview calendar. One per user for now.
  calendarConnection CalendarConnection?

  // Multi-tenancy (Phase 1, additive): a user can belong to several teams, with
  // a team-scoped role per membership. `role`/`profileId` above stay
  // authoritative until the Phase 2 auth cutover.
  memberships TeamMembership[]

  @@index([profileId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // store hash of token, not the token itself
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Profile (an independently-managed candidate record; a superadmin
// assigns it to any number of user accounts, and can add or remove
// accounts later without losing the profile's data) ──────────

model Profile {
  id String @id @default(cuid())

  // One profile, many accounts — e.g. several logins sharing one curated
  // candidate record. Managed from the profile's own admin page.
  users User[]

  // Envelope encryption: this DEK belongs to the profile itself (not
  // whichever user it's currently assigned to), so it survives assignment,
  // reassignment, and unassignment unchanged.
  encryptedDek String

  // --- Encrypted scalar PII (AES-256-GCM, via the profile's own DEK) ---
  // Each field is one opaque ciphertext blob; decrypted only in the app
  // layer, never in SQL.
  fullNameEnc     String // resume field
  contactEmailEnc String // resume field (may differ from login email)
  phoneEnc        String // resume field
  linkedinUrlEnc  String? // resume field
  dateOfBirthEnc  String? // REFERENCE-ONLY — must never reach tailoring/export
  addressEnc      String? // REFERENCE-ONLY full address, JSON {line1, line2, postalCode, country}
  cityEnc         String? // resume field (usable on resumes)
  stateEnc        String? // resume field (usable on resumes)

  professionalSummaryEnc String? // resume field, free text

  // Resume PDF style key (see src/lib/export/styles.ts). Null = use the app-wide
  // default (AppSettings.resumeTemplate). Plaintext, low sensitivity.
  resumeTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workHistory    WorkHistoryEntry[]
  education      EducationEntry[]
  certifications CertificationEntry[]
  skillGroups    SkillGroup[]
  resumes        Resume[]
  interviews     Interview[]

  // Multi-tenancy (Phase 1, additive; backfilled, required after Phase 2).
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

enum WorkingStyle {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum WorkingType {
  REMOTE
  HYBRID
  ON_SITE
}

model WorkHistoryEntry {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company     String // plaintext — low sensitivity, needed for sorting/search
  jobTitle    String
  location    String?
  workingStyle WorkingStyle? // Full-time / Part-time / Contract — unset for older entries
  workingType  WorkingType?  // Remote / Hybrid / On-site — unset for older entries
  startDate DateTime
  endDate   DateTime? // null = current role
  sortOrder Int       @default(0)

  achievementsEnc String // encrypted JSON string[] — bullet text can contain sensitive specifics

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model EducationEntry {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  institution String
  degree      String
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int       @default(0)

  @@index([profileId])
}

model CertificationEntry {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Plaintext, low-sensitivity resume facts (same treatment as EducationEntry).
  name      String // e.g. "AWS Certified Solutions Architect – Associate"
  issuer    String? // e.g. "Amazon Web Services"
  issueDate DateTime? // month/year granularity, stored as UTC-midnight of the 1st
  sortOrder Int      @default(0)

  @@index([profileId])
}

model SkillGroup {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Free text — a superadmin can add, rename, or remove categories per profile.
  category  String
  skills    String[] // plaintext — e.g. ["Python", "TypeScript"], no privacy concern
  sortOrder Int      @default(0)

  @@unique([profileId, category])
}

// ── Resume / Application tracking (many per user, one per job application) ──

// A job-application pipeline, not just a resume-generation state: DRAFT is
// the only pre-submission stage (job info saved, maybe tailored, not yet
// applied); everything after APPLIED mirrors how the employer's process
// actually progresses. FAIL/CANCELED are the two distinct "didn't work out"
// outcomes — kept separate because they mean different things for follow-up
// (FAIL = something on our side broke, worth retrying; CANCELED = the employer
// explicitly passed).
enum ResumeStatus {
  DRAFT
  APPLIED
  REPLY
  INTRO
  TECH1
  TECH2
  FINAL
  OFFER
  FAIL
  CANCELED
}

enum RoleTrack {
  BACKEND
  FRONTEND
  FULL_STACK
  DEVOPS_CLOUD
  DATA
  AI_ML
  SUPPORT_OPS
  MOBILE
  OTHER
}

enum ApplicationSource {
  JOB_BOARD
  LINKEDIN_OUTREACH
  RECRUITER
  OTHER
}

// A normal user uploads proof (a screenshot) that they actually submitted an
// application; only a superadmin can move it out of PENDING. APPROVED counts
// are that user's verified/trusted count of applications actually submitted.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Resume {
  id     String @id @default(cuid())
  // Who actually created/submitted this entry ("Applied By") — distinct from
  // profileId below, since several user accounts can share one profile and
  // each independently log applications for it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which candidate profile this application belongs to — the tracker is
  // shared by every user account assigned to the same profile (set from the
  // creator's assigned profile at creation time; kept in sync if it's
  // reassigned before tailoring). Null only if no profile was assigned yet
  // when this was logged.
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  jobLink        String? // plaintext, just a URL reference — also the primary duplicate-detection key
  companyName    String
  jobTitle       String
  jobDescription String @db.Text // plaintext — third-party posting text, not user PII

  // An application can hold several simultaneous pipeline stages at once
  // (e.g. Applied+Reply+Tech1) — each status change adds to this history
  // rather than replacing it, so the array reflects every stage reached so
  // far. Reporting collapses this into one "primary" status via a
  // most-final-wins precedence (see getPrimaryStatus in resume-status.ts).
  statuses   ResumeStatus[]    @default([DRAFT])
  roleTrack  RoleTrack         @default(OTHER)
  source     ApplicationSource @default(OTHER)

  notes        String?   @db.Text

  approvalStatus ApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  // Proof-of-submission screenshot a normal user uploads for superadmin review.
  screenshotData     Bytes?
  screenshotMimeType String?

  // Generated, tailored output — encrypted because it contains real
  // achievements/summary text tied to the user's identity.
  tailoredContentEnc String? // encrypted JSON: { summary, workHistory: [{entryId, bullets[]}], orderedSkills[] }
  modelUsed          String? // e.g. "gpt-4.1-mini" — for auditing/versioning
  promptVersion      String? // tags which prompt template produced this

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  generatedAt DateTime? // when AI tailoring last ran
  appliedAt   DateTime? // when user marked as applied

  usageEvents UsageEvent[]
  // Interviews created from this application (the source stays linked so the
  // interview can pull the tailored resume / job info). SetNull on the
  // interview side keeps interviews if the application is deleted.
  interviews  Interview[]
  // Cached application-checking verdict (see ApplicationCheck).
  check       ApplicationCheck?

  // Multi-tenancy (Phase 1, additive; backfilled from the owner/profile).
  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileId])
  @@index([userId, roleTrack])
  @@index([userId, source])
  @@index([approvalStatus])
  @@index([teamId])
}

// ── LLM usage tracking (cost visibility + rate limiting) ──

model UsageEvent {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  kind               String // "tailoring"
  model              String
  inputTokens        Int
  outputTokens       Int
  estimatedCostMicros Int // millionths of a dollar — a single call often costs a fraction of a cent

  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// ── App-wide settings (superadmin-managed, single row) ──

enum ResumeTemplate {
  MODERN
  CLASSIC
}

model AppSettings {
  // Fixed, well-known id — this table only ever has one row, enforced by
  // convention (getSettings/updateSettings in src/lib/settings.ts always
  // read/write this exact id) rather than a DB constraint.
  id String @id @default("singleton")

  openaiModel String @default("gpt-4.1-mini")
  // Encrypted directly with the app master key (same key that wraps every
  // Profile/User DEK) — null means "no override, fall back to the
  // OPENAI_API_KEY environment variable". Never returned to a client in
  // decrypted form; only src/lib/settings.ts's getOpenAiApiKey() reads it,
  // for the server-side OpenAI call itself.
  openaiApiKeyEnc String?
  // Null = use the built-in default prompt (DEFAULT_TAILORING_PROMPT in
  // src/lib/settings.ts) — avoids duplicating that long text into a migration.
  tailoringPrompt String? @db.Text
  resumeTemplate  ResumeTemplate @default(MODERN)

  // Interview Management: IANA timezone (e.g. "America/New_York") used to render
  // every interview time platform-wide. Validated against Intl in the app layer.
  interviewTimezone String @default("UTC")

  // Application-checking criteria — what makes an application "right". Editable
  // by a superadmin; these defaults are the required baseline.
  checkCountry     String @default("US") // target country (ISO-ish name/code), or "ANY"
  checkWorkStyle   String @default("REMOTE") // REMOTE | HYBRID | ONSITE | ANY
  checkJobCategory String @default("Computer Science / software roles: software engineering, AI/ML, DevOps, data engineering, security, IT, cloud, and closely related technical fields.") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Cached verdict of checking one application against the criteria in AppSettings.
 * One row per Resume (upserted). `criteriaHash` records which criteria produced
 * the verdict, so a criteria change marks existing rows stale (→ re-check)
 * without re-calling the LLM for anything already checked under the same rules.
 */
model ApplicationCheck {
  id       String @id @default(cuid())
  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  passed     Boolean
  countryOk  Boolean
  remoteOk   Boolean
  categoryOk Boolean

  detectedCountry   String?
  detectedWorkStyle String?
  detectedCategory  String?
  reason            String? @db.Text

  criteriaHash String
  checkedAt    DateTime @default(now())

  @@index([checkedAt])
  @@index([criteriaHash])
}

// ── Rate limiting ──────────────────────────────────────

// Not tied to User: signup/reset limiting is keyed by email and login by IP
// before any account is known. One row per (key, time window); the counter is
// incremented atomically per attempt (see src/lib/rate-limit.ts). Fixed-window
// buckets so an atomic upsert can enforce the limit without a lock held across
// round trips.
model RateLimitCounter {
  key         String // e.g. "login:ip:1.2.3.4" or "signup:1.2.3.4"
  windowStart DateTime // start of the fixed window this counter covers
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart]) // for pruning expired windows
}

// ── Interview Management ────────────────────────────────
//
// Config-driven lists (stages, statuses, meeting types) are TABLES, not enums,
// so a Manager can add/rename/reorder/deactivate options over time without a
// migration. Deactivating an option (active=false) never breaks historical
// interviews: the interview keeps the FK, and reads resolve the row regardless
// of `active` — `active` only controls whether it's offered in new pickers.
// The `count()`-append idiom (see src/lib/profile/skills.ts) sets sortOrder.

model InterviewStage {
  id        String  @id @default(cuid())
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]

  // Multi-tenancy (Phase 1, additive; each team configures its own lists).
  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([active, sortOrder])
  @@index([teamId])
}

model InterviewStatus {
  id        String  @id @default(cuid())
  label     String
  // Hex color for calendar/list pills — kept per-status so stages stay visually
  // distinct (mirrors STATUS_COLOR in src/lib/resume-status.ts, but data-driven).
  color     String  @default("#64748b")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]

  // Multi-tenancy (Phase 1, additive; each team configures its own lists).
  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([active, sortOrder])
  @@index([teamId])
}

model InterviewMeetingType {
  id        String  @id @default(cuid())
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]

  // Multi-tenancy (Phase 1, additive; each team configures its own lists).
  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([active, sortOrder])
  @@index([teamId])
}

model Interview {
  id String @id @default(cuid())

  // Who created it (a Manager/Super Admin). Kept on delete of the user? A user
  // delete cascades their created interviews — same as Resume.userId. If that's
  // ever undesirable this becomes SetNull, but it matches the Resume precedent.
  createdById String
  createdBy   User   @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // The assigned Caller (nullable — an interview can exist unassigned). SetNull
  // so deleting or reassigning the caller never deletes the interview.
  callerId String?
  caller   User?   @relation("InterviewCaller", fields: [callerId], references: [id], onDelete: SetNull)

  // Source Application (nullable — "from scratch" leaves this null). SetNull so
  // deleting the application keeps the interview, just unlinked.
  applicationId String?
  application   Resume? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Candidate profile for the (login-gated) shareable Profile view. Usually
  // copied from the source application at creation. SetNull on profile delete.
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // Config-driven FKs — all SetNull so deleting a config row never orphans-delete
  // an interview (in practice we deactivate rather than delete).
  stageId String?
  stage   InterviewStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  statusId String?
  status   InterviewStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  meetingTypeId String?
  meetingType   InterviewMeetingType? @relation(fields: [meetingTypeId], references: [id], onDelete: SetNull)

  // Core scalar fields — plaintext, consistent with how Resume treats posting
  // text (jobDescription/companyName) and operational notes (notes): these are
  // not the encrypted candidate PII, which lives on Profile.
  jobTitle        String
  jobDescription  String  @db.Text
  jobPostLink     String?
  companyName     String
  salaryRange     String?
  scheduledAt     DateTime? // the interview time; rendered in the Settings timezone
  meetingLink     String?
  interviewerInfo String? @db.Text // free text; may embed links

  // Optionally-attached resume file (bytes in Postgres, mirroring
  // Resume.screenshotData). When `applicationId` is set, the UI instead links to
  // the existing tailored-resume PDF route, so this stays null unless uploaded.
  resumeData     Bytes?
  resumeMimeType String?
  resumeFilename String?

  // Extensibility: open-ended metadata so future per-interview fields need no
  // migration. Rendered/edited via the field-definition registry
  // (src/lib/interview/fields.ts).
  meta Json @default("{}")

  // Soft delete — deletes are recoverable; every read filters `deletedAt: null`.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referenceFiles InterviewReferenceFile[]
  comments       InterviewComment[]
  // External calendar events matched/linked to this interview.
  externalEvents ExternalEvent[]

  // Multi-tenancy (Phase 1, additive; backfilled, required after Phase 2).
  teamId String?
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([statusId])
  @@index([stageId])
  @@index([scheduledAt])
  @@index([applicationId])
  @@index([deletedAt])
  @@index([teamId])
}

model InterviewReferenceFile {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  // Who uploaded it — SetNull so deleting the uploader keeps the file.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  filename String
  mimeType String
  size     Int
  data     Bytes

  createdAt DateTime @default(now())

  @@index([interviewId])
}

model InterviewComment {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  // Author — SetNull so deleting a user keeps their comments (shown as "Unknown").
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body String @db.Text

  createdAt DateTime @default(now())

  @@index([interviewId, createdAt])
}

// A Caller's recurring weekly availability. One row = one available hour slot,
// keyed by day-of-week (0=Sun..6=Sat) and hour (0..23) in the platform timezone
// (AppSettings.interviewTimezone). Presence of a row means "available"; saving
// replaces the caller's whole set. Managers/Super Admins read these in aggregate.
model CallerAvailability {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday … 6 = Saturday
  hour      Int // 0 … 23

  createdAt DateTime @default(now())

  @@unique([userId, dayOfWeek, hour])
  @@index([userId])
}

/**
 * A user's connected external calendar (Google now; Outlook later). Tokens are
 * encrypted with the app master key (same envelope scheme as profile DEKs).
 * One connection per user for now (@unique userId).
 */
model CalendarConnection {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider      String  @default("google") // google | microsoft
  accountEmail  String? // the connected calendar account, for display

  accessTokenEnc  String   @db.Text
  refreshTokenEnc String?  @db.Text
  expiresAt       DateTime // access-token expiry

  syncToken   String? @db.Text // provider incremental-sync cursor
  status      String  @default("active") // active | needs_reauth
  lastSyncedAt DateTime?
  lastError    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ExternalEvent[]

  @@index([status])
}

/**
 * One event pulled from a connected calendar, overlaid on the interview
 * calendar. `linkedInterviewId` ties it to a tracked Interview (matched by
 * iCal UID or confirmed by a manager) so the two aren't shown twice.
 */
model ExternalEvent {
  id           String             @id @default(cuid())
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String // denormalized owner, for scoping/queries

  provider   String  @default("google")
  externalId String // provider event id (stable within a calendar)
  icalUid    String? // cross-provider invite id, for matching to interviews

  title       String  @default("(no title)")
  description String? @db.Text
  location    String?
  organizer   String?
  htmlLink    String?

  startsAt DateTime
  endsAt   DateTime?
  allDay   Boolean  @default(false)
  status   String   @default("confirmed") // confirmed | cancelled

  linkedInterviewId String?
  linkedInterview   Interview? @relation(fields: [linkedInterviewId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([userId, startsAt])
  @@index([icalUid])
}

// ── Multi-tenancy (Teams) ─────────────────────────────
// Phase 1 is additive: these models + nullable teamId columns are backfilled by
// scripts/setup.ts into a single default team, with no behavior change yet. The
// Phase 2 auth cutover moves role resolution to TeamMembership and enforces the
// team scope everywhere; teamId becomes required then.

model Team {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           TeamMembership[]
  settings              TeamSettings?
  profiles              Profile[]
  resumes               Resume[]
  interviews            Interview[]
  interviewStages       InterviewStage[]
  interviewStatuses     InterviewStatus[]
  interviewMeetingTypes InterviewMeetingType[]

  @@index([active])
}

// A user's membership in a team, with the role they hold *in that team*. The
// same account can be TEAM_ADMIN in one team and CALLER in another. A bidder's
// assigned profile is per-team, so it lives here too.
model TeamMembership {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  role             UserRole @default(BIDDER) // team-scoped role (TEAM_ADMIN/MANAGER/CALLER/BIDDER)
  assignedProfileId String?

  // What this bidder earns per APPROVED application in this team (USD). Set by
  // team admins/managers; drives the bidder dashboard's earnings. Default $0.08.
  applicationRate  Float    @default(0.08)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([teamId])
}

// Per-team settings — the old AppSettings singleton, one row per team. Each team
// brings its own OpenAI key (openaiApiKeyEnc); generation/checks require it.
model TeamSettings {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  openaiModel     String         @default("gpt-4.1-mini")
  openaiApiKeyEnc String?
  tailoringPrompt String?        @db.Text
  resumeTemplate  ResumeTemplate @default(MODERN)

  interviewTimezone String @default("UTC")

  checkCountry     String @default("US")
  checkWorkStyle   String @default("REMOTE")
  checkJobCategory String @default("Computer Science / software roles: software engineering, AI/ML, DevOps, data engineering, security, IT, cloud, and closely related technical fields.") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
